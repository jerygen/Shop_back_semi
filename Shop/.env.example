APP_IMAGE=shop-app:latest
APP_BIND_HOST=0.0.0.0
APP_PORT=9000

# MySQL container settings
MYSQL_BIND_HOST=127.0.0.1
MYSQL_DATABASE=shop
MYSQL_USER=admin
MYSQL_PASSWORD=admin1234
MYSQL_ROOT_PASSWORD=admin1234

# Spring application database settings
DB_URL=jdbc:mysql://mysql:3306/shop?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=admin
DB_PASSWORD=admin1234

# Spring application runtime settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JWT_SECRET=change_me_to_a_long_random_secret

# Optional admin bootstrap account
ADMIN_USER_ID=admin
ADMIN_PASSWORD=admin1234
ADMIN_USER_NAME=Administrator
