#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y ca-certificates curl docker.io

mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/download/v2.27.1/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

systemctl enable docker
systemctl start docker

mkdir -p /opt/shop

cat > /opt/shop/.env <<'ENV'
APP_IMAGE=${app_image}
APP_BIND_HOST=0.0.0.0
APP_PORT=${app_port}

MYSQL_DATABASE=${mysql_database}
MYSQL_USER=${mysql_user}
MYSQL_PASSWORD=${mysql_password}
MYSQL_ROOT_PASSWORD=${mysql_root_password}

DB_URL=jdbc:mysql://mysql:3306/${mysql_database}?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=${mysql_user}
DB_PASSWORD=${mysql_password}

JPA_DDL_AUTO=${jpa_ddl_auto}
JPA_SHOW_SQL=${jpa_show_sql}
JWT_SECRET=${jwt_secret}

ADMIN_USER_ID=${admin_user_id}
ADMIN_PASSWORD=${admin_password}
ADMIN_USER_NAME=${admin_user_name}
ENV

chmod 600 /opt/shop/.env

cat > /opt/shop/docker-compose.yml <<'COMPOSE'
services:
  app:
    image: $${APP_IMAGE}
    container_name: shop-app
    restart: unless-stopped
    ports:
      - "$${APP_BIND_HOST:-0.0.0.0}:$${APP_PORT:-9000}:9000"
    environment:
      SERVER_PORT: 9000
      DB_URL: "$${DB_URL}"
      DB_USERNAME: "$${DB_USERNAME}"
      DB_PASSWORD: "$${DB_PASSWORD}"
      JPA_DDL_AUTO: "$${JPA_DDL_AUTO:-update}"
      JPA_SHOW_SQL: "$${JPA_SHOW_SQL:-false}"
      JWT_SECRET: "$${JWT_SECRET}"
      ADMIN_USER_ID: "$${ADMIN_USER_ID:-}"
      ADMIN_PASSWORD: "$${ADMIN_PASSWORD:-}"
      ADMIN_USER_NAME: "$${ADMIN_USER_NAME:-Administrator}"
    depends_on:
      mysql:
        condition: service_healthy

  mysql:
    image: mysql:8.4
    container_name: shop-mysql
    restart: unless-stopped
    ports:
      - "127.0.0.1:3306:3306"
    environment:
      MYSQL_DATABASE: "$${MYSQL_DATABASE:-shop}"
      MYSQL_USER: "$${MYSQL_USER:-admin}"
      MYSQL_PASSWORD: "$${MYSQL_PASSWORD}"
      MYSQL_ROOT_PASSWORD: "$${MYSQL_ROOT_PASSWORD}"
      TZ: Asia/Seoul
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u root -p$${MYSQL_ROOT_PASSWORD}"]
      interval: 10s
      timeout: 5s
      retries: 10

volumes:
  mysql_data:
COMPOSE

chown -R ubuntu:ubuntu /opt/shop
usermod -aG docker ubuntu || true

docker compose --env-file /opt/shop/.env -f /opt/shop/docker-compose.yml up -d mysql

if docker image inspect "${app_image}" >/dev/null 2>&1 || docker pull "${app_image}"; then
  docker compose --env-file /opt/shop/.env -f /opt/shop/docker-compose.yml up -d app
else
  echo "Application image ${app_image} is not available yet. MySQL is running; deploy the app image with CI/CD later."
fi
